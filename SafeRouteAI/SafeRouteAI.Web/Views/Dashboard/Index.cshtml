@{
    ViewData["Title"] = "Road safety overview";
}

<section class="page-head split">
    <div>
        <div class="eyebrow">ROAD SAFETY OVERVIEW</div>
        <h1>Your road-safety <em>snapshot.</em></h1>
        <p>Journey and community information will appear when connected services are available.</p>
    </div>
    <a class="btn" asp-controller="Routes" asp-action="Plan">＋ Plan a route</a>
</section>

<section class="stats" aria-label="Road safety information availability">
    <article>
        <small>Recent route searches</small>
        <strong>Unavailable</strong>
        <span>Route history is not connected.</span>
    </article>
    <article>
        <small>Community reports</small>
        <strong>Unavailable</strong>
        <span>Report data is not connected.</span>
    </article>
    <article>
        <small>Risk assessment</small>
        <strong>Unavailable</strong>
        <span>Risk data is not connected.</span>
    </article>
</section>

<section class="two-col dashboard">
    <div class="content">
        <div class="eyebrow">RECENT JOURNEYS</div>
        <h2>Recent routes</h2>
        <div class="empty-state" role="status">
            <p>Route-history data is currently unavailable.</p>
        </div>
    </div>
    <aside class="content">
        <div class="eyebrow">COMMUNITY</div>
        <h2>Incident reports</h2>
        <p>No community reports available.</p>
        <a class="btn wide" asp-controller="Reports" asp-action="Index">Report an incident</a>
        <p><a asp-controller="Reports" asp-action="MyReports">View my reports →</a></p>
    </aside>
</section>
