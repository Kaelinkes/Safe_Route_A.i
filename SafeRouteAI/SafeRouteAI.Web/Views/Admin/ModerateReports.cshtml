@{
    ViewData["Title"] = "Moderate reports";
}
@model SafeRouteAI.Web.Models.Pages.ModerationPageViewModel

<section class="page-head">
    <div class="eyebrow">ADMINISTRATOR</div>
    <h1>Moderate <em>reports.</em></h1>
    <p>Review pending community reports saved in the database.</p>
</section>

@if (TempData["ModerationSuccess"] is string success)
{
    <p class="route-message success" role="status">@success</p>
}
@if (TempData["ModerationError"] is string moderationError)
{
    <p class="route-message error" role="alert">@moderationError</p>
}
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <p class="route-message error" role="alert">@Model.ErrorMessage</p>
}

<section class="content admin-page">
    <div class="content-title">
        <div>
            <div class="eyebrow">COMMUNITY REPORTS</div>
            <h2>Report review queue</h2>
        </div>
    </div>

    @if (Model.Reports.Count > 0)
    {
    <div class="table-scroll">
        <table class="moderation-table">
            <thead>
                <tr>
                    <th>Reported</th>
                    <th>Type and location</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="moderationRows">
                @foreach (var report in Model.Reports)
                {
                    <tr>
                        <td>@report.ReportedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td>
                        <td>@report.IncidentType<br /><small>@report.Latitude.ToString("F5", System.Globalization.CultureInfo.InvariantCulture), @report.Longitude.ToString("F5", System.Globalization.CultureInfo.InvariantCulture)</small></td>
                        <td>@(string.IsNullOrWhiteSpace(report.Description) ? "—" : report.Description)</td>
                        <td>@report.Status</td>
                        <td>
                            <form asp-action="ModerateReport" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="reportId" value="@report.ReportId" />
                                <button class="btn small" type="submit" name="status" value="Approved">Approve</button>
                                <button class="btn outline small" type="submit" name="status" value="Rejected">Reject</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    }
    else if (string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div id="moderationEmpty" class="empty-state" role="status">
            <h2>No reports are awaiting review.</h2>
        </div>
    }

</section>
